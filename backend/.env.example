FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Signs login tokens. Use a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
# If it's missing, a random key is used and logins reset whenever the server restarts.
SECRET_KEY=change-me-to-a-long-random-string
# Optional. Leave unset to use the local SQLite file (backend/zoom.db).
# In production set it to a Postgres URL, e.g. postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=
